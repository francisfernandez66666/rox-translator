# X 凭据模板 —— 复制成 .env 后填值。★ .env 已被 .gitignore 覆盖，禁止入库
# 申请步骤见 X每日推文机器人_方案_20261013.md §4（共 7 步）

# 开发者门户 Projects → Keys and tokens 里的 API Key
X_CLIENT_ID=

# OAuth 2.0 PKCE 换来的 refresh_token（长期有效，access_token 由程序自动维护）
X_REFRESH_TOKEN=

# 以下由程序自动写入，一般不用手填
X_ACCESS_TOKEN=
X_TOKEN_EXPIRES_AT=

# 目标账号（如 lexi）—— 发推用这个账号登录开发者门户
X_USER_ID=