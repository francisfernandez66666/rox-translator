{
  "name": "@langcross/translator-sdk",
  "version": "1.0.2",
  "description": "翻译助手 langcross 开放 API TypeScript 客户端（与 Python SDK 契约一致）",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc --noEmit && npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langcross/langcross.git",
    "directory": "sdk/typescript"
  },
  "keywords": [
    "translation",
    "langcross",
    "sdk"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.4.0"
  }
}
