[Unit]
# fpd-expiry.service · 到期自毁：清空工作目录 + 打 EXPIRED 标记 + 关掉自己
# ★ 这是「产物必须回主站」那条硬口径的第二重保险（第一重在主站：Go 侧同步回拉＋远端只允许写 w/）。
#   即便主站的回归 timer 没跑成功、或厂商到期后没立刻回收机器，这台机器上也已经主动清干净并拒绝服务了。
#   方向是 fail-safe：它只删远端 w/ 下的会话目录，**不碰**依赖、脚本、配置（那些不是客户数据）。
Description=One-shot self-destruct of the dispatch worker at expiry
After=local-fs.target

[Service]
Type=oneshot
User=fpd
Group=fpd
EnvironmentFile=-/opt/fpdispatch/etc/fpd.env
# 到期日由 timer 的 OnCalendar 保证；这里再强制把 TTL 压成 1 秒 ⇒ sweep 会把所有会话目录一次清空，
# 并且 fpdexec 内部还会检查 FPD_EXPIRE_DATE 落 EXPIRED 标记（两侧都认日期，不依赖单点）。
ExecStart=/bin/sh -c 'FPD_TTL_SEC=1 /opt/fpdispatch/.venv/bin/python3 /opt/fpdispatch/bin/fpdexec.py --mode sweep'
ExecStartPost=/bin/sh -c 'rm -rf /opt/fpdispatch/w/* ; :'
# 清完顺手停掉两个 timer，避免到期后每天报红（报红三次以上就会被当成"故障"误排障）
ExecStartPost=/bin/systemctl disable --now fpd-sweep.timer fpd-expiry.timer
