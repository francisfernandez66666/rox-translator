# ============================================================================
# translator-dispatch-expiry.service · 主站侧**到期自动回归**（改造方案 §14，§11-P5）
#
# 为什么主站也要有一份到期闹钟（远端已经有 fpd-expiry.timer 了）：
#   远端那份是"清干净 + 拒服"，管的是**远端不留数据**；
#   本份管的是**主站别再拨一台已经不存在的机器**——
#   远端到期后若主站还在派发，每一单都要付一次"上传 40MB → 超时 → 回落本地"的双份时间，
#   客户体感是"变慢了"，日志里只有回落计数在涨，很容易被当成"远端不稳"反复排障。
#   ⇒ 到期那天由**主站自己**把闸关掉，两端各认日期，不依赖单点。
#
# 判据（fail-safe 方向）：未到期 ⇒ 直接退出 0，什么都不做；
#   到期 / 到期日文件缺失 ⇒ 不动作（保守，不擅自关正在运行的派发）；
#   只有"今天 ≥ 到期日"才执行 dispatch_revert.sh，把 drop-in 摘掉并重启。
#
# 安装（由 scripts/dispatch_apply.sh 自动完成，一般不用手工）：
#   cp deploy/systemd/translator-dispatch-expiry.{service,timer} /etc/systemd/system/
#   install -m 0755 scripts/dispatch_revert.sh /opt/translator/bin/
#   systemctl daemon-reload && systemctl enable --now translator-dispatch-expiry.timer
# ============================================================================
[Unit]
Description=Revert remote dispatch on the worker expiry date
After=network-online.target

[Service]
Type=oneshot
# 脚本本身做幂等判断（未到期即退 0），所以这里不需要再包一层 date 比较——
# 包一层就等于把"到期日从哪读"这件事复制两份，改日期时要改两处，属于典型的漂移源。
ExecStart=/bin/bash /opt/translator/bin/dispatch_revert.sh --if-expired
# 关完闸顺手把自己停掉：到期后每天触发一个必然无事可做的 oneshot，
# 只会让 journalctl 里多出一堆噪声，把真正的故障信号淹掉。
ExecStartPost=/bin/systemctl disable --now translator-dispatch-expiry.timer

[Install]
WantedBy=multi-user.target
