# ai-assist systemd unit 模板（★ autosales，2026-09-16 已上线主站）
# 安装：cp deploy/systemd/ai-assist.service /etc/systemd/system/
#       mkdir -p /etc/ai-assist && vi /etc/ai-assist/secrets.env  # 见下
#       chown -R translator:translator /opt/ai-assist
#       systemctl daemon-reload && systemctl enable --now ai-assist
#
# /etc/ai-assist/secrets.env（0600）：
#   ASSIST_ADDR=127.0.0.1:8790
#   ASSIST_DB=/opt/ai-assist/data/assist.db
#   ASSIST_SEED=/opt/ai-assist/seed/seed.json
#   ASSIST_WEB=/opt/ai-assist/web
#   ASSIST_CORS=https://langcross.lexicorn.cn
#   ASSIST_ADMIN_TOKEN=<openssl rand -hex 24>
#   # LLM（OpenAI 兼容；不配则走知识库/话术规则兜底）：
#   #ASSIST_LLM_BASE_URL=https://api.siliconflow.cn/v1
#   #ASSIST_LLM_API_KEY=sk-xxxx
#   #ASSIST_LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
#   #ASSIST_LLM_MODEL_BACKUP=THUDM/glm-4-9b-chat

[Unit]
Description=AI Assist (sales & support widget service)
After=network.target

[Service]
Type=simple
User=translator
Group=translator
WorkingDirectory=/opt/ai-assist
EnvironmentFile=/etc/ai-assist/secrets.env
ExecStart=/opt/ai-assist/bin/assist-server
Restart=always
RestartSec=3
StandardOutput=append:/opt/ai-assist/data/assist.log
StandardError=append:/opt/ai-assist/data/assist.log
# 1.6G 小内存机基线（主站 1229M / PG 256M 之外的上限）
MemoryMax=150M

[Install]
WantedBy=multi-user.target
