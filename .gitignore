# ============ 通用忽略 ============
__pycache__/
.DS_Store
.env
*.log

# ============ 构建产物 / 运行数据（不入仓库） ============
build/
dist/
frontend/dist/
node_modules/
# 本地开发库与运行数据（tm_embeddings.npz 已跟踪故不整目录忽略；gitignore 不支持行内注释）
data/dev.db
data/dev.db-shm
data/dev.db-wal
data/*.npz.tmp
# ★ 2026-09-18 清理：上面 data/ 规则锚定仓库根，匹配不到子目录，补全三类运行产物——
# backend-go 本地开发库、外部 AI 工具会话产物、vite 配置重载时生成的 timestamp 临时文件
backend-go/data/
.workbuddy/
vite.config.ts.timestamp-*.mjs

# ============ 前端自动化测试产物（不入仓库） ============
frontend-react/artifacts/
frontend-react/test-results/

# ============ Python 旧栈遗留（栈已退役，规则保留防复发） ============
*.egg-info/
*.manifest
*.pyc
*.pyz
*.spec
*.spec.backup
backend/.deps_installed
backend/data/_output/
backend/data/_uploads/

# ============ 密钥与凭证（防复发，gitleaks 门禁配套） ============
secrets.env
*.secrets.env
*_token.txt

# ★ 修正记录（2026-08-26 全仓评审 D7）：
#   原 `/*.md` 规则把根目录全部交付文档（部署指南/PROGRESS/各整改方案）
#   挡在版本库之外——客户拿到 repo 即失去全部文档，已删除该规则；
#   文档自本批起应随代码一并提交。
#   ⚠️ 历史遗留清理（ignore 对已跟踪文件无效，需运维窗口执行一次）：
#     git rm -r --cached frontend/node_modules
#     git rm --cached $(git ls-files | grep -E "^\.(DS_Store|.*\.DS_Store)$")
#     git commit -m "chore: untrack node_modules and .DS_Store"

# ai-assist（AI 销售/客服独立服务）运行时数据
ai-assist/data/
ai-assist/assist-server

# ============ 发版交叉编译产物（★ 2026-09-29 收尾批入册） ============
# 发布流程会在 backend-go/ 下交叉编译出 Linux 二进制（实测 32M），它「不随源码变化、
# 每次发版重生成一份」，属一次性产物。以前只靠「记得别 add」挡着：既污染 git status，
# 也极易被一次 `git add -A` 误送进仓库（32M 二进制一旦进了历史，清理要改写已推送提交）。
# 按 §一·9「远端只放代码」的精神，产物一律不入版本库，这里从机制上兜住。
backend-go/*-linux
