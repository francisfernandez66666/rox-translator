# ============ 通用忽略 ============
__pycache__/
.DS_Store
.env
*.log

# ============ 构建产物 / 运行数据（不入仓库） ============
build/
dist/
frontend/dist/
node_modules/
data/            # 本地知识库向量与开发库（tm_embeddings.npz / dev.db）

# ============ 前端自动化测试产物（不入仓库） ============
frontend-react/artifacts/
frontend-react/test-results/

# ============ Python 旧栈遗留（栈已退役，规则保留防复发） ============
*.egg-info/
*.manifest
*.pyc
*.pyz
*.spec
*.spec.backup
backend/.deps_installed
backend/data/_output/
backend/data/_uploads/

# ============ 密钥与凭证（防复发，gitleaks 门禁配套） ============
secrets.env
*.secrets.env
*_token.txt

# ★ 修正记录（2026-08-26 全仓评审 D7）：
#   原 `/*.md` 规则把根目录全部交付文档（部署指南/PROGRESS/各整改方案）
#   挡在版本库之外——客户拿到 repo 即失去全部文档，已删除该规则；
#   文档自本批起应随代码一并提交。
#   ⚠️ 历史遗留清理（ignore 对已跟踪文件无效，需运维窗口执行一次）：
#     git rm -r --cached frontend/node_modules
#     git rm --cached $(git ls-files | grep -E "^\.(DS_Store|.*\.DS_Store)$")
#     git commit -m "chore: untrack node_modules and .DS_Store"
